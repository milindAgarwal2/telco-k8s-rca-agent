{
  "name": "bos-aide-dashboard",
  "displayName": "MACS BOS AIDE Dashboard",
  "description": "Workspace-local Kiro and AIDE metrics dashboard",
  "version": "0.1.3",
  "publisher": "macs-bos-aide",
  "license": "SEE LICENSE IN LICENSE.txt",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Visualization", "Other"],
  "extensionKind": ["ui"],
  "main": "./extension.js",
  "scripts": {"package": "vsce package --no-dependencies --allow-missing-repository"},
  "devDependencies": {"@vscode/vsce": "3.9.1"},
  "activationEvents": ["onStartupFinished", "onCommand:bosAide.openDashboard"],
  "contributes": {
    "commands": [
      {"command": "bosAide.openDashboard", "title": "BOS AIDE: Open Metrics Dashboard"}
    ]
  }
}
