flowchart TB

    title["DETAIL &mdash; Detection"]:::ttl

    subgraph SRC["Inputs"]
        direction LR
        AM["Alertmanager webhook<br/>POST /webhook/alertmanager"]:::src
        API["K8s API (read-only)<br/>events + pod status"]:::src
    end

    subgraph DET["Detection"]
        direction TB
        WH["Webhook handler<br/>parse Alertmanager payload"]:::comp
        EW["EventWatcher.poll_once()<br/>every 15s"]:::comp
        NEW["new-fault detect<br/>(Warning events)"]:::comp
        STAT["status detect<br/>(persistently unhealthy pods)"]:::comp
        DEDUP["dedup by event UID<br/>(bounded seen-set)"]:::comp
        MERGE["merge into open<br/>anchor incident"]:::comp
        EW --> NEW
        EW --> STAT
        NEW --> DEDUP
        STAT --> DEDUP
        DEDUP --> MERGE
    end

    OUT["Alert &rarr; Reasoning pipeline"]:::out

    AM --> WH --> OUT
    API --> EW
    MERGE --> OUT

    classDef ttl fill:#1f3a6b,stroke:#1f3a6b,color:#fff,font-weight:bold;
    classDef src fill:#fff4e6,stroke:#d98a1f,color:#333;
    classDef comp fill:#eef4ff,stroke:#3b6fd4,color:#1f3a6b;
    classDef out fill:#eafaf0,stroke:#2e9e5b,color:#1d6b3d,font-weight:bold;
