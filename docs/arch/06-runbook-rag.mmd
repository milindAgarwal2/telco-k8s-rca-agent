flowchart TB

    title["DETAIL &mdash; Runbook RAG (local, offline &mdash; no network, no embeddings)"]:::ttl

    UP["Dashboard Runbooks tab<br/>upload PDF / MD / TXT"]:::src

    subgraph STORE["LocalRunbookStore"]
        direction TB
        EX["extract_text<br/>(PDF layout cleanup)"]:::comp
        CH["chunk_text<br/>paragraph / section chunks"]:::comp
        PS["persist to JSON store"]:::comp
        EX --> CH --> PS
    end

    subgraph RET["LocalRunbookRetriever"]
        direction TB
        QN["normalize query tokens<br/>(strip stopwords + K8s hashes)"]:::comp
        SC["rarity-weighted keyword / TF-IDF<br/>best chunk per document"]:::comp
        QN --> SC
    end

    Q["Query from build_next_steps<br/>cause + ImagePullBackOff / OOMKilled / ..."]:::src
    HIT["RunbookHit(s)<br/>title + snippet + source + score"]:::out
    NULL["No docs &rarr; NullRetriever<br/><i>honest 'no runbook source' note</i>"]:::note

    UP --> STORE
    PS --> RET
    Q --> QN
    SC --> HIT
    RET -. empty store .-> NULL

