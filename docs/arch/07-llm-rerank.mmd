    classDef src fill:#fff4e6,stroke:#d98a1f,color:#333;
    classDef comp fill:#eef4ff,stroke:#3b6fd4,color:#1f3a6b;
    classDef out fill:#eafaf0,stroke:#2e9e5b,color:#1d6b3d,font-weight:bold;
    classDef note fill:#fdf2f2,stroke:#c0392b,color:#7b241c;
