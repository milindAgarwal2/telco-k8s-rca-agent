%%{init: {'theme':'base','themeVariables':{'fontSize':'15px','primaryColor':'#eef4ff','primaryBorderColor':'#3b6fd4','lineColor':'#5b6b86','clusterBkg':'#fafcff','clusterBorder':'#c7d4ea'}}}%%
flowchart TB

    title["DETAIL &mdash; LLM Rerank (optional, fully local &mdash; default OFF)"]:::ttl

    IN["IncidentReport<br/>(ranked hypotheses from rules)"]:::src

    subgraph CLIENT["llm_rerank client"]
        direction TB
        BP["build strict-JSON prompt<br/>existing ids + evidence"]:::comp
        VAL["validate order<br/>(permutation or reject)"]:::comp
        ECHO["anti-echo guard<br/>drop explanation repeating cause"]:::comp
        BP --> VAL --> ECHO
    end

    subgraph SIDE["llama.cpp sidecar (separate container)"]
        direction TB
        SRV["OpenAI-compatible server<br/>127.0.0.1:8090"]:::comp
        MODEL["Qwen2.5-1.5B Q4_K_M (GGUF)<br/>volume-mounted, air-gapped<br/>Broadwell-safe build"]:::comp
        SRV --- MODEL
    end

    OUT["IncidentReport<br/>reordered + WHY explanation"]:::out
    FB["any failure &rarr; extractive<br/>ranking unchanged (fallback)"]:::note

    IN --> BP
    ECHO -->|HTTP| SRV
    SRV --> VAL
    ECHO --> OUT
    CLIENT -. on error .-> FB

