    O["4&nbsp;&middot;&nbsp;REPORT<br/>ranked cause + evidence chain<br/>+ blast radius + next steps + citations"]:::comp

    G["Live Dependency Graph<br/>(NetworkX, rebuilt 60s)"]:::side
    RB["Runbook RAG<br/>(local, offline)"]:::side
    L["LLM rerank<br/>(optional, local sidecar)"]:::side

    ALERT --> D
    K8S --> D
    D --> E --> R --> O

    R -. reads .-> G
    O -. next steps .-> RB
    O -. "if LLM mode" .-> L
    L -. reorder + explain .-> O

