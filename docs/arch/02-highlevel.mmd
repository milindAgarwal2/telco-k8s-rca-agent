flowchart LR

    subgraph IN["Inputs"]
        direction TB
        ALERT["Alertmanager webhook<br/><i>inbound POST</i>"]:::src
        K8S["OpenShift / K8s API<br/><i>read-only: get/list/watch</i>"]:::src
    end

    D["1&nbsp;&middot;&nbsp;DETECT<br/>webhook + event watcher (15s)"]:::comp
    E["2&nbsp;&middot;&nbsp;GATHER EVIDENCE<br/>pod status, events, logs<br/>(untrusted text fenced)"]:::comp
